{
  "module": "zlanpiko",
  "go_min": "1.26",
  "targets": ["windows/amd64"],
  "build_flags": ["-trimpath"],
  "ldflags_vars": [
    "zlanpiko/internal/app.Version",
    "zlanpiko/internal/app.Commit",
    "zlanpiko/internal/app.BuildDate"
  ],
  "outputs": {
    "zlanpiko": "dist\\zlanpiko.exe",
    "installer": "dist\\zlanpiko-installer.exe"
  },
  "package_contents": [
    "zlanpiko.exe",
    "zlanpiko-installer.exe",
    "README.txt",
    "CHANGELOG.txt",
    "checksums.txt"
  ]
}
